{
  "expo": {
    "name": "Roadmap to Crafting Log",
    "slug": "roadmap-to-crafting-log",
    "owner": "apocaarg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/roadmap-logo.png",
    "scheme": "roadmaptocraftinglog",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.apocaarg.roadmaptocraftinglog"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111c29",
        "foregroundImage": "./assets/images/roadmap-logo.png"
      },
      "package": "com.apocaarg.roadmaptocraftinglog",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b121c",
          "image": "./assets/images/roadmap-logo.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
